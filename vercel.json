{
  "version": 2,
  "rewrites": [
    {
      "source": "/raw/(.*)",
      "destination": "/api/raw?id=$1"
    },
    {
      "source": "/raw",
      "destination": "/api/raw"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|raw).*)",
      "destination": "/index.html"
    }
  ]
}
